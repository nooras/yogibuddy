# Ollama runs the open-source model locally. No API key is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Hosted production chat (configure as server-side environment variables on Vercel).
# Never use a VITE_ prefix or commit a real token.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest

# Optional: used only by the standalone Express API (`npm run server`).
PORT=3001
APP_ORIGIN=http://localhost:5173
