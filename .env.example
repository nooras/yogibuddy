# Ollama runs the open-source model locally. No API key is required.
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional hosted chat for local testing; set CHAT_PROVIDER=huggingface to enable.
# On Vercel or Render, configure these as server-side environment variables instead.
# Never use a VITE_ prefix or commit a real token.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional: used only by the standalone Express API (`npm run server`).
PORT=3001
APP_ORIGIN=http://localhost:5173
